        if (fork() == -1) {
            char *str = NULL;
            switch (errno) {
                case EAGAIN:
                  str = "EAGAIN";
                  break;
                case ENOMEM:
                  str = "ENOMEM";
                  break;
                case ENOSYS:
                  str = "ENOSYS";
                  break;

              }
          }
